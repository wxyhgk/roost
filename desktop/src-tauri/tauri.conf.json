{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roost",
  "version": "../../package.json",
  "identifier": "com.roost.desktop",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "windows": [],
